# FSK Image Service — переменные окружения
# Скопировать в .env и заполнить

# S3 (Yandex Object Storage)
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=us-east-1
S3_BUCKET=fsk-service
S3_PREFIX=fsk-generate-image
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Telegram мониторинг (алерты при ошибках)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
