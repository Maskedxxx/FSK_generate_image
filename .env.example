# Скопировать в .env и заполнить значениями

# Порт сервиса
APP_PORT=8000
# Воркеры (1 пока tasks в памяти, для масштабирования → Redis + больше воркеров)
WORKERS=1

# OpenRouter API (Gemini для генерации)
OPENROUTER_API_KEY=sk-or-v1-xxx

# OSMI платформа (Flowise)
OSMI_LAYER1_URL=https://app.osmi-ai.ru/api/v1/prediction/xxx
OSMI_LAYER2_URL=https://app.osmi-ai.ru/api/v1/prediction/xxx

# API-ключ для авторизации фронта
FSK_API_KEY=fsk-gen-2026-xxxxx

# Модели
LAYER1_MODEL=google/gemini-3-flash-preview
GEMINI_MODEL=google/gemini-3.1-flash-image-preview
