# Скопировать в .env и заполнить OPENROUTER_API_KEY

# Порт сервиса
APP_PORT=8003
# Воркеры (1 пока tasks в памяти, для масштабирования → Redis + больше воркеров)
WORKERS=1

# OpenRouter API
OPENROUTER_API_KEY=

# OSMI платформа
# FSK_Layer1_TextAnalysis — текстовый анализ
OSMI_LAYER1_URL=
# FSK_Layer2_ImageGen — генерация с 1 изображением
OSMI_LAYER2_URL=
# FSK_Layer2_ImageGen_Dual — генерация с 2 изображениями
OSMI_LAYER2_DUAL_URL=

# API-ключ для авторизации фронта
FSK_API_KEY=fsk-gen-2026-a7b3c9d1e5f2

# Модели
LAYER1_MODEL=google/gemini-3-flash-preview
GEMINI_MODEL=google/gemini-3.1-flash-image-preview

# Хранилище: "local" (файловая система) или "s3" (Yandex Object Storage)
STORAGE_BACKEND=local

# S3 (Yandex Object Storage) — заполнить если STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=us-east-1
S3_BUCKET=fsk-service
# Корневая папка в бакете (имя сервиса)
S3_PREFIX=fsk-generate-image
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Telegram мониторинг (алерты при ошибках)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
